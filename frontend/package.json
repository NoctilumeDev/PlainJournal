{
  "name": "plain-journal-frontend",
  "private": true,
  "version": "1.0.4",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:storefront": "pnpm --filter @plain-journal/storefront-web dev",
    "dev:admin": "pnpm --filter @plain-journal/admin-web dev",
    "dev:mock-api": "node e2e/mock-api.mjs",
    "preview:storefront": "pnpm --filter @plain-journal/storefront-web exec vite preview --host 127.0.0.1 --port 18300 --strictPort",
    "preview:admin": "pnpm --filter @plain-journal/admin-web exec vite preview --host 127.0.0.1 --port 18301 --strictPort",
    "demo:start": "node tools/production-fixture.mjs start",
    "demo:status": "node tools/production-fixture.mjs status",
    "demo:stop": "node tools/production-fixture.mjs stop",
    "container:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/production-container-fixture.ps1 -Action verify",
    "container:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/production-container-fixture.ps1 -Action status",
    "container:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/production-container-fixture.ps1 -Action stop",
    "release:screenshots": "node tools/capture-release-screenshots.mjs",
    "images:generate": "python tools/image-variants.py",
    "images:check": "python tools/image-variants.py --check",
    "check:boundaries": "node --test tools/layer-boundaries.test.mjs && node tools/check-layer-boundaries.mjs",
    "check:delivery": "node --test tools/delivery-readiness.test.mjs && node tools/check-delivery-readiness.mjs",
    "check:production-deploy": "node --test tools/production-deployment.test.mjs && node tools/check-production-deployment.mjs",
    "check:release": "node --test tools/release-readiness.test.mjs && node tools/check-release-readiness.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm --workspace-concurrency=1 -r --if-present run test:coverage && node tools/check-coverage.mjs",
    "build": "pnpm -r --if-present run build",
    "e2e": "node tools/run-e2e.mjs",
    "e2e:production": "node tools/run-production-e2e.mjs",
    "e2e:production:built": "node tools/run-production-e2e.mjs --skip-build",
    "e2e:v4": "node tools/run-e2e.mjs --config=playwright.v4.config.ts --storefront-only",
    "e2e:v5": "node tools/run-e2e.mjs --config=playwright.v5.config.ts --storefront-only",
    "e2e:v5-2": "node tools/run-e2e.mjs --config=playwright.v5-2.config.ts --storefront-only",
    "e2e:v5-3": "node tools/run-e2e.mjs --config=playwright.v5-3.config.ts --storefront-only",
    "e2e:v6-1": "node tools/run-e2e.mjs --config=playwright.v6-1.config.ts --storefront-only",
    "e2e:v6-2": "node tools/run-e2e.mjs --config=playwright.v6-2.config.ts --storefront-only",
    "e2e:v6-3": "node tools/run-e2e.mjs --config=playwright.v6-3.config.ts --storefront-only",
    "e2e:v6-4": "node tools/run-e2e.mjs --config=playwright.v6-4.config.ts --admin-only",
    "check": "pnpm check:boundaries && pnpm check:delivery && pnpm check:production-deploy && pnpm check:release && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm e2e && pnpm e2e:production:built"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "4.1.10"
  }
}
