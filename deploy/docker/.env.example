COMPOSE_PROJECT_NAME=plainjournal
APP_ENV=local
MIDDLEWARE_DATA_ROOT=./.data

MYSQL_IMAGE_TAG=8.4.10
MYSQL_PORT=13306
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
CATALOG_REPLICA_PORT=13316

IDENTITY_DB_NAME=ecom_identity
IDENTITY_DB_USER=ecom_identity_app
# IDENTITY_DB_PASSWORD and IDENTITY_JWT_SECRET are generated by bootstrap-resources.ps1.
# Define either value here only when an external secret manager provides it.
# TRADE_INTERNAL_SERVICE_TOKEN and PAYMENT_INTERNAL_SERVICE_TOKEN are generated as
# different credentials. Services fail closed when their relationship-specific
# credential is absent; no shared internal-service credential is accepted.

CATALOG_DB_NAME=ecom_catalog
CATALOG_DB_USER=ecom_catalog_app
# CATALOG_DB_PASSWORD is generated by bootstrap-resources.ps1.

INVENTORY_DB_NAME=ecom_inventory
INVENTORY_DB_USER=ecom_inventory_app
# INVENTORY_DB_PASSWORD is generated by bootstrap-resources.ps1.

TRADE_DB_NAME=ecom_trade
TRADE_DB_USER=ecom_trade_app
# TRADE_DB_PASSWORD is generated by bootstrap-resources.ps1.
TRADE_IMAGE_TAG=local
TRADE_SHARD_0_DB_NAME=ecom_trade_shard_0
TRADE_SHARD_1_DB_NAME=ecom_trade_shard_1
TRADE_SHARD_DB_USER=ecom_trade_shard_app
# TRADE_SHARD_DB_PASSWORD is generated by bootstrap-resources.ps1.
TRADE_SHARD_1_PORT=13326

PAYMENT_DB_NAME=ecom_payment
PAYMENT_DB_USER=ecom_payment_app
# PAYMENT_DB_PASSWORD and MOCK_PAYMENT_CALLBACK_SECRET are generated by bootstrap-resources.ps1.

FULFILLMENT_DB_NAME=ecom_fulfillment
FULFILLMENT_DB_USER=ecom_fulfillment_app
# FULFILLMENT_DB_PASSWORD is generated by bootstrap-resources.ps1.

MARKETING_DB_NAME=ecom_marketing
MARKETING_DB_USER=ecom_marketing_app
# MARKETING_DB_PASSWORD is generated by bootstrap-resources.ps1.

CHAT_DB_NAME=ecom_chat
CHAT_DB_USER=ecom_chat_app
# CHAT_DB_PASSWORD is generated by bootstrap-resources.ps1.
NOTIFICATION_DB_NAME=ecom_notification
NOTIFICATION_DB_USER=ecom_notification_app
# NOTIFICATION_DB_PASSWORD is generated by bootstrap-resources.ps1.
ANALYTICS_DB_NAME=ecom_analytics
ANALYTICS_DB_USER=ecom_analytics_app
# ANALYTICS_DB_PASSWORD is generated by bootstrap-resources.ps1.

REDIS_IMAGE_TAG=7.4.9-alpine
REDIS_PORT=16379
REDIS_PASSWORD=change-me

NACOS_IMAGE_TAG=v3.2.2
NACOS_CONSOLE_PORT=18080
NACOS_CLIENT_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_ADMIN_PASSWORD=replace-with-strong-password
NACOS_AUTH_TOKEN=replace-with-base64-token-longer-than-32-bytes
NACOS_AUTH_IDENTITY_KEY=ecommerce-server
NACOS_AUTH_IDENTITY_VALUE=change-me

GATEWAY_IMAGE_TAG=local

ROCKETMQ_IMAGE_TAG=5.3.2
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_PROXY_REMOTING_PORT=18081
ROCKETMQ_PROXY_GRPC_PORT=18082

MINIO_IMAGE_TAG=RELEASE.2025-06-13T11-33-47Z
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=ecommerce_admin
MINIO_ROOT_PASSWORD=change-me

# Optional M8 malware scan profile. It is started only for attachment scanning
# development and verification, and is not part of the seven-container core baseline.
CLAMAV_IMAGE_TAG=1.5.3-debian13-slim
CLAMAV_PORT=13310

# Optional M8 search profile. OpenSearch is a disposable, rebuildable Catalog
# projection and is not part of the seven-container core baseline.
OPENSEARCH_IMAGE=public.ecr.aws/opensearchproject/opensearch:3.7.0
OPENSEARCH_PORT=19200

# Optional observability profile. METRICS_SCRAPE_TOKEN and GRAFANA_ADMIN_PASSWORD
# are generated by bootstrap-resources.ps1 and remain only in the ignored .env.
PROMETHEUS_IMAGE_TAG=v3.12.0
PROMETHEUS_PORT=19090
ALERTMANAGER_IMAGE_TAG=v0.32.1
ALERTMANAGER_PORT=19093
GRAFANA_IMAGE_TAG=13.1.0
GRAFANA_PORT=13000
TEMPO_IMAGE_TAG=2.10.5
TEMPO_HTTP_PORT=13200
TEMPO_OTLP_HTTP_PORT=14318
